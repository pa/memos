# Context rules for the root Dockerfile (skoop image). BuildKit uses this
# file instead of .dockerignore for that Dockerfile. The web app is included
# because this image builds it.
/build/
/bin/
/tmp/
/memos
/memos.exe
coverage.out
/.pnpm-store/
/.worktrees/
/docs/
/.github/
/.git/
/.env
/.env.*
/.idea/
/.vscode/
/.claude/
/.skoop/
**/.DS_Store
web/node_modules/
web/dist/
server/frontend/dist/
